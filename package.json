    "@trpc/react-query": "^11.8.0",
    "@trpc/server": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "express": "^4.22.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.16",
    "neo4j-driver": "^6.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
